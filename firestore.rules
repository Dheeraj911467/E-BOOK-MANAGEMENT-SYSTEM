rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // User profiles: Users can read and write their own profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow list, delete: if false;

      // Subcollection for user purchased books
      match /purchased_books/{bookDocId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Orders collection: user can create and read their own orders
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
